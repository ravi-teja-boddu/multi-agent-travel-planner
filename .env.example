# Copy to .env and fill in your keys:  cp .env.example .env

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: chat model (default gpt-5.2) and temperature (default 0.2)
OPENAI_CHAT_MODEL=gpt-5.2
# OPENAI_TEMPERATURE=0.2

# Tavily web search - https://app.tavily.com
TAVILY_API_KEY=

# SerpAPI (Google Flights / Google Hotels) - https://serpapi.com/manage-api-key
# SERP_API_KEY is also accepted.
SERPAPI_API_KEY=
